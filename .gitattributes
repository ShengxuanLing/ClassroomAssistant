# 换行与二进制规则：Windows 本地 + 公开仓多人协作
* text=auto

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 代码与文档统一 LF
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# TASK-110 打包资产 (PyInstaller spec / Inno Setup 脚本) 同样保持 LF
*.spec text eol=lf
*.iss text eol=lf

# 二进制不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.whl binary
*.zip binary
*.onnx binary
